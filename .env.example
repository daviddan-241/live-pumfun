# ==============================================================================
# ARCC Telegram Intelligence & Publishing System - Environment Variables
# ==============================================================================

# Telegram MTProto API Credentials (obtained from https://my.telegram.org)
# TELEGRAM_API_ID: Integer - Your Telegram API ID
TELEGRAM_API_ID=12345678

# TELEGRAM_API_HASH: String - Your Telegram API Hash
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# TELEGRAM_SESSION: String - GramJS user account session string for MTProto authentication
TELEGRAM_SESSION=1B...

# Web Dashboard & Service Settings
# DASHBOARD_PORT: Integer - Port for Express SSE dashboard server (default: 3000)
DASHBOARD_PORT=3000

# LOG_LEVEL: String - Winston logging level (debug, info, warn, error)
LOG_LEVEL=info

# ENABLE_DASHBOARD: Boolean - Enable or disable the Express web dashboard (default: true)
ENABLE_DASHBOARD=true

# Source Monitoring Configuration
# SOURCE_CHANNELS: JSON Array - List of source channel usernames or numeric Telegram IDs to monitor
SOURCE_CHANNELS=["Alpha_Circle1", "Maestrosdegen", "BRUCECALL0"]

# Destination Channels & Publishing Settings
# PRIVATE_GROUP_ID: String/Integer - Private group chat ID (can be populated after first run)
PRIVATE_GROUP_ID=

# PUBLIC_CHANNEL_USERNAME: String - Public channel username (without @)
PUBLIC_CHANNEL_USERNAME=Aires_Insider

# CONFIDENCE_THRESHOLD: Float - Minimum confidence score (0.0 to 1.0) required to auto-publish signals
CONFIDENCE_THRESHOLD=0.6

# PNL_FORMAT: String - Prefix or format tag for profit/loss updates
PNL_FORMAT=/pnl

# ARCC_CONTACT: String - Primary contact telegram handle for ARCC system support
ARCC_CONTACT=@William_ARCC

# PRIVATE_GROUP_LINK: String - Telegram invite link for the private subscriber group
PRIVATE_GROUP_LINK=https://t.me/+NxFFO4JXdF8zMWU0

# Storage & Runtime Processing Configuration
# DB_PATH: String - Path to local SQLite database file
DB_PATH=./data/arcc.db

# WORKER_CONCURRENCY: Integer - Maximum concurrent processing jobs
WORKER_CONCURRENCY=4

# HEARTBEAT_INTERVAL: Integer - System status heartbeat interval in milliseconds
HEARTBEAT_INTERVAL=30000
